APP_NAME=Room Booking API

# development = เครื่องตัวเอง, production = ระบบจริง (บังคับ PostgreSQL และ SECRET_KEY ใหม่)
ENVIRONMENT=development
LOG_LEVEL=INFO

# กฎการจอง (ชั่วโมงตามเวลาท้องถิ่นของ TIMEZONE)
OPEN_HOUR=8
CLOSE_HOUR=20
MAX_BOOKING_HOURS=4
TIMEZONE=Asia/Bangkok

# ฐานข้อมูลตอนรันบนเครื่อง: SQLite (ค่าเริ่มต้น) หรือ PostgreSQL
# (docker compose ตั้ง DATABASE_URL ให้เองจาก POSTGRES_* ด้านล่าง)
DATABASE_URL=sqlite:///./room_booking.db
# DATABASE_URL=postgresql+psycopg://room:room@localhost:5432/room_booking

# JWT: สร้างค่าใหม่ด้วย python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=60

# กันเดารหัสผ่าน: login ผิดเกินกี่ครั้งภายในกี่นาทีจะถูกพัก
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# ใช้กับ docker compose เท่านั้น
POSTGRES_USER=room
POSTGRES_PASSWORD=change-me
POSTGRES_DB=room_booking
API_PORT=8000
